# Copy to .env and fill in. `uv run --env-file .env ...` loads it.
# Free key, instant, by email: https://api.nasa.gov  (DEMO_KEY works but is capped at 50 requests/day)
NASA_API_KEY=DEMO_KEY


# MotherDuck access token, from https://app.motherduck.com -> Settings -> Access Tokens. Used when db_path is md:neos
MOTHERDUCK_TOKEN=

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
DISCORD_WEBHOOK_URL=
